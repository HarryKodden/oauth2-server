# OAuth2 Server Environment Configuration
# Copy this file to .env and update the values as needed

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Public base URL for the OAuth2 server (used in tokens and discovery)
PUBLIC_BASE_URL=http://localhost:8080

# Server port
PORT=8080

# =============================================================================
# PROXY MODE CONFIGURATION
# =============================================================================
# When these environment variables are set, the server runs in proxy mode
# and forwards authentication requests to an upstream OAuth2 provider

# Upstream OAuth2 provider URL (e.g., Google, Auth0, Keycloak)
# Setting this enables proxy mode
UPSTREAM_PROVIDER_URL=https://accounts.google.com

# Client ID for the upstream provider
UPSTREAM_CLIENT_ID=your-upstream-client-id

# Client secret for the upstream provider
UPSTREAM_CLIENT_SECRET=your-upstream-client-secret

# Callback URL for the upstream provider (should point back to this server)
# You can set this dynamically using OAUTH2_SERVER_URL when running tests, e.g.
#   UPSTREAM_CALLBACK_URL=${OAUTH2_SERVER_URL:-http://localhost:8080}/callback
UPSTREAM_CALLBACK_URL=${OAUTH2_SERVER_URL:-http://localhost:8080}/callback

# =============================================================================
# UPSTREAM PROMPT POLICY (proxy mode)
# =============================================================================
# Control whether the proxy sets OIDC "prompt" when redirecting to the upstream provider.
#
# When enabled, the server decides between e.g. prompt=login vs prompt=consent using:
# - eduID flow if scope contains "eduID", OR
# - authorization_details contains an item where:
#     type == "openid_credential" AND credential_configuration_id == "eduID"
#
# How it interacts with an incoming prompt parameter:
# - set_if_missing: only set prompt if caller did not provide one (default)
# - override: always replace any caller-provided prompt
# - append: always add the policy decision alongside any caller-provided prompt
UPSTREAM_PROMPT_POLICY_ENABLED=false
UPSTREAM_PROMPT_POLICY_MODE=set_if_missing

# Values to send upstream
UPSTREAM_PROMPT_DEFAULT=consent
UPSTREAM_PROMPT_CUSTOM=login

# Custom flow detection knobs (set these to your business values, e.g. eduID)
UPSTREAM_PROMPT_CUSTOM_SCOPE=eduID
UPSTREAM_PROMPT_CUSTOM_AUTHZ_DETAILS_TYPE=openid_credential
UPSTREAM_PROMPT_CUSTOM_CREDENTIAL_CONFIGURATION_ID=eduID

# =============================================================================
# UPSTREAM PROMPT POLICIES (multiple rules; proxy mode)
# =============================================================================
# If you have multiple custom flows, define named policies and evaluate them in order.
# First matching policy wins. Matching uses AND logic across configured matchers.
#
# Example:
#   - eduID issuance flow => prompt=login
#   - another flow => remove prompt entirely
#
# UPSTREAM_PROMPT_POLICIES=EDUID,ANOTHER
#
# UPSTREAM_PROMPT_POLICY_EDUID_MODE=set_if_missing
# UPSTREAM_PROMPT_POLICY_EDUID_ACTION=set
# UPSTREAM_PROMPT_POLICY_EDUID_PROMPT=login
# UPSTREAM_PROMPT_POLICY_EDUID_MATCH_SCOPE=eduID
# UPSTREAM_PROMPT_POLICY_EDUID_MATCH_AUTHZ_DETAILS_TYPE=openid_credential
# UPSTREAM_PROMPT_POLICY_EDUID_MATCH_CREDENTIAL_CONFIGURATION_ID=eduID
#
# UPSTREAM_PROMPT_POLICY_ANOTHER_MODE=override
# UPSTREAM_PROMPT_POLICY_ANOTHER_ACTION=remove
# UPSTREAM_PROMPT_POLICY_ANOTHER_MATCH_SCOPE=anotherScope

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# JWT signing key (use a strong, random key in production)
JWT_SIGNING_KEY=your-very-secure-jwt-signing-key-here

# Require a local proxy consent screen after upstream callback and before redirecting
# back to downstream clients. This applies globally in proxy mode.
REQUIRE_PROXY_CONSENT=false

# =============================================================================
# DEVELOPMENT/DEBUG CONFIGURATION
# =============================================================================

# Enable debug logging
LOG_LEVEL=debug

# Log format (json or text)
LOG_FORMAT=json

# Enable audit logging
ENABLE_AUDIT=true

# =============================================================================
# DPOP (RFC 9449) — Demonstrating Proof of Possession
# =============================================================================
# When enabled, clients may send a DPoP proof header on /token to receive
# sender-constrained tokens (token_type=DPoP, cnf.jkt). Existing Bearer clients
# continue to work unless DPOP_REQUIRED=true.

DPOP_ENABLED=false
DPOP_REQUIRED=false
DPOP_NONCE_REQUIRED=false
# DPOP_MAX_CLOCK_SKEW_SECONDS=120

# When DPOP_NONCE_REQUIRED=true, token requests with a DPoP header but no
# valid nonce receive HTTP 400 error=use_dpop_nonce and a DPoP-Nonce header.
# Authorization binding: pass dpop_jkt=... (or a DPoP proof) on /authorize or PAR.

# =============================================================================
# PROXY/TRUSTED NETWORKS
# =============================================================================

# Trust proxy headers (X-Forwarded-*, etc.)
TRUST_PROXY_HEADERS=true

# Force HTTPS redirects
FORCE_HTTPS=false

# =============================================================================
# EXAMPLES FOR DIFFERENT PROVIDERS
# =============================================================================

# Google OAuth2
# UPSTREAM_PROVIDER_URL=https://accounts.google.com
# UPSTREAM_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# UPSTREAM_CLIENT_SECRET=your-google-client-secret

# Auth0
# UPSTREAM_PROVIDER_URL=https://your-tenant.auth0.com
# UPSTREAM_CLIENT_ID=your-auth0-client-id
# UPSTREAM_CLIENT_SECRET=your-auth0-client-secret

# Keycloak
# UPSTREAM_PROVIDER_URL=https://your-keycloak-server/auth/realms/your-realm
# UPSTREAM_CLIENT_ID=your-keycloak-client-id
# UPSTREAM_CLIENT_SECRET=your-keycloak-client-secret